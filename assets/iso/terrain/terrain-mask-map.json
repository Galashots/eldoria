  "sourceCropLayout": {
    "sheet": "259x195",
    "cell": "64x48",
    "topFace": "64x32 native runtime diamond",
    "gutter": "1px internal gutter on both axes",
    "xOrigins": [0, 65, 130, 195],
    "yOrigins": [0, 49, 98, 147],
    "rowOrder": "north-to-south",
    "columnOrder": "west-to-east"
  },
  "families": {
    "path": {
      "sourcePrefix": "grass-to-path",
      "runtimePrefix": "iso_terrain_path_",
      "secondaryMaterial": "path"
    },
    "soil": {
      "sourcePrefix": "grass-to-soil",
      "runtimePrefix": "iso_terrain_soil_",
      "secondaryMaterial": "soil"
    },
    "water": {
      "sourcePrefix": "grass-to-water",
      "runtimePrefix": "iso_terrain_water_",
      "secondaryMaterial": "water"
    }
  },
  "materialPriorityHighToLow": ["water", "soil", "path", "grass"],
  "selection": {
    "grassCenter": "sourceMask = sameFamilyMask; choose the highest-priority adjacent non-grass family",
    "secondaryCenter": "sourceMask = 15 XOR sameFamilyMask when no higher-priority neighbor exists",
    "higherPriorityNeighbor": "hard edge: use sourceMask 0 for the current secondary material",
    "plainGrass": "choose one of the three grass-base-* variants by deterministic row/column hash"
  },
  "checkerboardTieBreak": "If a 2x2 saddle contains multiple non-grass families, the center tile chooses the highest-priority adjacent family; equal-priority ties resolve water, then soil, then path, then grass. The runtime never uses sheet order to resolve a saddle."
}
