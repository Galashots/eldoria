    { "mask": 10, "row": 2, "column": 2, "sourceTile": "tile_10", "label": "east + west" },
    { "mask": 11, "row": 2, "column": 3, "sourceTile": "tile_11", "label": "north + east + west" },
    { "mask": 12, "row": 3, "column": 0, "sourceTile": "tile_12", "label": "south + west" },
    { "mask": 13, "row": 3, "column": 1, "sourceTile": "tile_13", "label": "north + south + west" },
