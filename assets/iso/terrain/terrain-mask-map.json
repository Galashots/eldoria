    "sourceMaskMeaning": "the explicit source-sheet tile selected after applying center-family polarity"
  },
  "sourceGrid": [
    { "mask": 0, "row": 0, "column": 0, "sourceTile": "tile_0", "label": "none" },
    { "mask": 1, "row": 0, "column": 1, "sourceTile": "tile_1", "label": "north" },
    { "mask": 2, "row": 0, "column": 2, "sourceTile": "tile_2", "label": "east" },
