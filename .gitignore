# OS / editor cruft
Thumbs.db
Desktop.ini
.DS_Store

# Node (only if a helper tool ever gets installed; the game itself stays dependency-free)
node_modules/
npm-debug.log*

# Local test/dev scratch output (not part of the game)
.playwright-mcp/
.lighthouseci/
_srv_out.txt
_srv_err.txt

# Gemini CLI local settings and GitHub App credentials
.gemini/
gha-creds-*.json

# Raw ChatGPT sprite exports — large source images, processed into assets/ by
# tools/process-sprite.mjs. Keep them local; only the processed PNGs get committed.
art-incoming/

# Personal scratch art / reference images kept local (filenames may include family
# names). Store them under art-incoming/ (already ignored above) so a stray
# `git add -A` never stages them.

# Brainstorming visual-companion mockups / scratch (local only)
.superpowers/

# Track 2(b) Ranger 3D probe scratch: raw 512px Blender renders, TRELLIS inputs
# and any .glb/.blend intermediates. Regenerate with tools/3d/ranger_iso_scene.py;
# only the normalized 64x64 PNGs and evidence sheets are committed.
_probe_local/
